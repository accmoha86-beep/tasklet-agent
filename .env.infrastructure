# Full Infrastructure Requirements

# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# GitHub Configuration
GITHUB_TOKEN=your-github-token-here
GITHUB_USERNAME=accmoha86-beep
GITHUB_REPO=tasklet-agent
GITHUB_AUTO_COMMIT=true
GITHUB_AUTO_PUSH=true

# Sandbox Configuration
SANDBOX_ENABLED=true
SANDBOX_PYTHON_PATH=/usr/bin/python3
SANDBOX_SHELL_PATH=/bin/bash
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=2048

# Storage Configuration
STORAGE_BASE_PATH=./storage
STORAGE_LOGS_PATH=./storage/logs
STORAGE_MEMORY_PATH=./storage/memory
STORAGE_CONFIGS_PATH=./storage/configs
STORAGE_STAGING_PATH=./storage/staging

# Memory Configuration
MEMORY_ENABLED=true
MEMORY_TYPE=file  # file or database
MEMORY_PERSISTENCE=true
MEMORY_AUTO_SAVE=true

# Logging Configuration
LOGGING_LEVEL=DEBUG
LOGGING_FORMAT=json
LOGGING_AUTO_COMMIT=true
LOGGING_TO_FILE=true
LOGGING_TO_MARKDOWN=true

# Web Configuration
WEB_SEARCH_ENABLED=true
WEB_SCRAPE_ENABLED=true
WEB_TIMEOUT=10
WEB_USER_AGENT=Tasklet-Agent/1.0

# Auto-commit Configuration
AUTO_COMMIT_INTERVAL=300
AUTO_COMMIT_ON_TASK_COMPLETE=true
AUTO_COMMIT_MESSAGE_PREFIX=[Tasklet]

# Agent Configuration
AGENT_MAX_STEPS=20
AGENT_TIMEOUT=600
AGENT_DEBUG=true
AGENT_AUTO_SAVE_MEMORY=true
AGENT_AUTO_LOG=true
