# LLM Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4
LLM_API_KEY=your-api-key-here
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000

# GitHub Configuration
GITHUB_TOKEN=your-github-token-here
GITHUB_USERNAME=your-username
GITHUB_ORG=optional-org-name

# Agent Configuration
AGENT_MAX_STEPS=10
AGENT_TIMEOUT=300
AGENT_MEMORY_SIZE=50
DEBUG_MODE=true
LOG_LEVEL=INFO
